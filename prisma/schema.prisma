generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  username        String?    @unique
  emailVerified   DateTime?
  emailVerifToken String?    @db.VarChar(255)
  password        String?
  image           String?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  name            String?
  firstName       String?
  lastName        String?
  bio             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  posts       Post[]
  comments    Comment[]
  likes       Like[]
  caseStudies CaseStudy[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id               String  @id @default(cuid())
  title            String
  slug             String? @unique
  type             Type?   @default(BLOG)
  imageUrl         String?
  imageCredit      String?
  publicId         String?
  openingParagraph String?
  tableOfContents  String?
  content          String
  published        Boolean @default(false)
  featured         Boolean @default(false)

  authorEmail String?
  author      User?   @relation(fields: [authorEmail], references: [email])

  catName  String?
  category Category? @relation(fields: [catName], references: [catName])

  tags Tag[]

  comments Comment[]
  likes    Like[]

  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id      String  @id @default(cuid())
  catName String  @unique
  posts   Post[]
  postIDs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String

  postSlug String?
  post     Post?   @relation(fields: [postSlug], references: [slug])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userEmail String?
  user      User?   @relation(fields: [userEmail], references: [email])
}

model Like {
  id       String  @id @default(cuid())
  postSlug String?
  post     Post?   @relation(fields: [postSlug], references: [slug])

  userEmail String?
  user      User?   @relation(fields: [userEmail], references: [email])
}

model Tag {
  id        String   @id @default(cuid())
  tagName   String?  @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudy {
  id                String             @id @default(cuid())
  title             String
  slug              String?            @unique
  clientName        String? // e.g. "Acme Corp"
  industry          String? // e.g. "Fintech", "E-commerce", "Healthcare"
  projectTimeline   String? // e.g. "3 months", "Q2 2025"
  teamSize          Int? // optional
  challenge         String?            @db.Text // The problem the client had
  solution          String?            @db.Text // High-level what you did
  results           String?            @db.Text // Outcomes, metrics, ROI
  keyMetrics        Json? // e.g. { "revenueGrowth": "142%", "conversionIncrease": "38%" }
  testimonial       String?            @db.Text // Optional client quote
  testimonialAuthor String? // Name & title of person who gave testimonial
  imageUrl          String? // Hero / main image
  imageCredit       String?
  publicId          String? // If using Cloudinary or similar
  gallery           Gallery[] // Reusing your existing Gallery model for multiple images
  content           String             @db.Text // Full markdown / rich content
  excerpt           String?            @db.Text // Short summary for listings (150-300 chars)
  published         Boolean            @default(false)
  featured          Boolean            @default(false)
  authorEmail       String?
  author            User?              @relation(fields: [authorEmail], references: [email])
  tags              CaseStudyTag[]
  category          CaseStudyCategory? @relation(fields: [catName], references: [catName])
  catName           String?
  views             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
}

model CaseStudyTag {
  id          String      @id @default(cuid())
  tagName     String      @unique
  caseStudies CaseStudy[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CaseStudyCategory {
  id          String      @id @default(cuid())
  catName     String      @unique
  caseStudies CaseStudy[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String?  @unique
  imageUrl         String?
  imageCredit      String?
  imageUrls        String[]
  imageCreditUrls  String[] @default([])
  shortDescription String?
  description      String
  featured         Boolean  @default(false)

  type       ProjectType?     @default(FULLSTACK)
  catName    String?
  category   ProjectCategory? @relation(fields: [catName], references: [catName])
  galleries  Gallery[]
  tags       ProjectTag[]
  projectUrl String?

  caseStudies CaseStudy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id          String     @id @default(cuid())
  publicId    String?    @unique
  format      String
  version     String
  caseStudyId String?
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProjectTag {
  id        String    @id @default(cuid())
  tagName   String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProjectCategory {
  id        String    @id @default(cuid())
  catName   String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Type {
  BLOG
  CASE_STUDIES
  RESOURCES
  GUIDE
}

enum ProjectType {
  BACKEND
  FRONTEND
  FULLSTACK
  MOBILE
  AI
  AUTOMATION
  WEB3
  OTHER
}
